# Safed Injera Backend (PostgreSQL)
# Copy this file to .env and fill in real values.

# Recommended: single connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/safed_injera

# Alternative (if you prefer individual PG env vars)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=safed_injera
# PGUSER=postgres
# PGPASSWORD=password

PORT=5000
JWT_SECRET=change-me

# Allowed origins for CORS
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:5173
